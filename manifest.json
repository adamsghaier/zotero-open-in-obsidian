{
  "manifest_version": 2,
  "name": "Open in Obsidian",
  "version": "1.1.0",
  "description": "Right-click a paper → Open in Obsidian opens its literature note (<citekey>.md) in a new Obsidian tab.",
  "author": "Adam Sghaier",
  "applications": {
    "zotero": {
      "id": "open-in-obsidian@adamsghaier.local",
      "update_url": "https://raw.githubusercontent.com/adamsghaier/zotero-open-in-obsidian/main/updates.json",
      "strict_min_version": "8.0",
      "strict_max_version": "10.*"
    }
  },
  "homepage_url": "https://github.com/adamsghaier/zotero-open-in-obsidian"
}
